# Copy to .env and fill in. Never commit .env.
# See ../JARVIS/CONFIG.md for full documentation.

# Required for voice features (server-side only, never sent to the browser).
OPENAI_API_KEY=

# Path to the Obsidian vault root. Defaults to the repository root
# (this app is designed to live inside the vault it serves).
JARVIS_VAULT_PATH=..

# debug | info | warn | error
JARVIS_LOG_LEVEL=info

# development | test | production
JARVIS_ENV=development

# Local dev port. Ignored if the hosting platform sets PORT itself
# (Render, Heroku, Railway, ...) — that always takes priority.
JARVIS_PORT=3939

# Model id used for the OpenAI Realtime API session.
JARVIS_REALTIME_MODEL=gpt-realtime

# Model id used for general-conversation replies in the text-chat fallback
# (small talk / open-ended questions only — tasks/schedule/notes/memory
# stay deterministic). Only used when OPENAI_API_KEY is set.
JARVIS_TEXT_MODEL=gpt-4o-mini
