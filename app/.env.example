# Copy to .env and fill in. Never commit .env.
# See ../JARVIS/CONFIG.md for full documentation.

# Required for voice features (server-side only, never sent to the browser).
OPENAI_API_KEY=

# Optional: when both are set, JARVIS speaks using this ElevenLabs voice
# instead of an OpenAI Realtime built-in voice (OpenAI still handles
# listening/transcription and reasoning). Server-side only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Path to the Obsidian vault root. Defaults to the repository root
# (this app is designed to live inside the vault it serves).
JARVIS_VAULT_PATH=..

# debug | info | warn | error
JARVIS_LOG_LEVEL=info

# development | test | production
JARVIS_ENV=development

JARVIS_PORT=3939

# Model id used for the OpenAI Realtime API session.
JARVIS_REALTIME_MODEL=gpt-realtime
