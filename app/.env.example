# Copy to .env and fill in. Never commit .env.
# See ../JARVIS/CONFIG.md for full documentation.

# The conversational "brain" for general chit-chat in the text/voice
# fallback (tasks/schedule/notes/memory stay deterministic regardless).
# Get a free key at aistudio.google.com/apikey — no card required.
# Server-side only, never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: when both are set, JARVIS speaks replies aloud using this
# ElevenLabs voice. Server-side only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Path to the Obsidian vault root. Defaults to the repository root
# (this app is designed to live inside the vault it serves).
JARVIS_VAULT_PATH=..

# debug | info | warn | error
JARVIS_LOG_LEVEL=info

# development | test | production
JARVIS_ENV=development

# Local dev port. Ignored if the hosting platform sets PORT itself
# (Render, Heroku, Railway, ...) — that always takes priority.
JARVIS_PORT=3939
