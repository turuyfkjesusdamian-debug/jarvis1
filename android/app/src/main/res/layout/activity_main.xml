<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060310"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="JARVIS"
            android:textColor="#EDE9FE"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servidor"
            android:textColor="#9A8BC4"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/server_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="url"
            android:hint="https://tu-servidor.onrender.com"
            android:inputType="textUri"
            android:textColor="#EDE9FE"
            android:textColorHint="#5a4d80" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="#9A8BC4"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="password"
            android:hint="Contraseña de JARVIS"
            android:inputType="textPassword"
            android:textColor="#EDE9FE"
            android:textColorHint="#5a4d80" />

        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#A855F7"
            android:text="Guardar e iniciar sesión"
            android:textColor="#0B0517" />

        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Sin conexión todavía."
            android:textColor="#9A8BC4"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="#2c1a54" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje de prueba"
            android:textColor="#9A8BC4"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/test_message_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:hint="hola, ¿cómo estás?"
            android:inputType="text"
            android:textColor="#EDE9FE"
            android:textColorHint="#5a4d80" />

        <Button
            android:id="@+id/send_test_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#A855F7"
            android:text="Enviar mensaje de prueba"
            android:textColor="#0B0517" />

        <TextView
            android:id="@+id/reply_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12092A"
            android:padding="16dp"
            android:text="La respuesta de JARVIS va a aparecer aquí."
            android:textColor="#EDE9FE" />

        <TextView
            android:id="@+id/audio_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#9A8BC4"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
