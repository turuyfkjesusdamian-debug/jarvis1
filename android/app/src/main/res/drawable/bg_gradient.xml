<?xml version="1.0" encoding="utf-8"?>
<!-- Approximates the web UI's radial background gradient (styles.css :root
     "radial-gradient(ellipse at 50% 30%, #140832 0%, #060310 55%, #030108 100%)"). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="480dp"
        android:centerX="0.5"
        android:centerY="0.32"
        android:startColor="#140832"
        android:centerColor="#060310"
        android:endColor="#030108" />
</shape>
